/* OKIDIA — Açık Tema */

QMainWindow, QWidget {
    background-color: #eff1f5;
    color: #4c4f69;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 13px;
}

QMainWindow::separator {
    background: #ccd0da;
    width: 1px;
    height: 1px;
}

/* Menü */
QMenuBar {
    background-color: #e6e9ef;
    color: #4c4f69;
    border-bottom: 1px solid #ccd0da;
}
QMenuBar::item:selected { background: #d0d5e3; }
QMenu {
    background: #eff1f5;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item { padding: 5px 24px 5px 12px; border-radius: 4px; }
QMenu::item:selected { background: #d0d5e3; }
QMenu::separator { height: 1px; background: #ccd0da; margin: 4px 8px; }

/* Toolbar / Actionbar */
QToolBar, QWidget#centralwidget > QWidget {
    background: #e6e9ef;
}

/* Splitter */
QSplitter::handle { background: #ccd0da; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }

/* DockWidget */
QDockWidget {
    titlebar-close-icon: url(none);
    color: #4c4f69;
}
QDockWidget::title {
    background: #e6e9ef;
    border-bottom: 1px solid #ccd0da;
    padding: 4px 8px;
    font-weight: 500;
}
QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
    border-radius: 3px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: #ccd0da;
}

/* TabWidget */
QTabWidget::pane { border: none; background: #eff1f5; }
QTabBar { background: #e6e9ef; }
QTabBar::tab {
    background: transparent;
    color: #6c6f85;
    padding: 5px 14px;
    border-bottom: 2px solid transparent;
    font-size: 12px;
}
QTabBar::tab:selected {
    color: #1e66f5;
    border-bottom: 2px solid #1e66f5;
}
QTabBar::tab:hover:!selected { color: #4c4f69; }

/* TreeWidget */
QTreeWidget {
    background: #e6e9ef;
    border: none;
    color: #4c4f69;
    alternate-background-color: #eff1f5;
}
QTreeWidget::item { padding: 4px 2px; border-radius: 4px; }
QTreeWidget::item:selected {
    background: rgba(30,102,245,0.15);
    color: #1e66f5;
}
QTreeWidget::item:hover:!selected { background: rgba(0,0,0,0.05); }
QTreeWidget::branch:selected { background: rgba(30,102,245,0.10); }

/* ListWidget */
QListWidget {
    background: #e6e9ef;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    color: #4c4f69;
    outline: none;
}
QListWidget::item { padding: 5px 8px; border-radius: 4px; margin: 1px 2px; }
QListWidget::item:selected {
    background: rgba(30,102,245,0.15);
    color: #1e66f5;
}
QListWidget::item:hover:!selected { background: rgba(0,0,0,0.05); }

/* PushButton */
QPushButton {
    background: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 5px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton:hover { background: #d0d5e3; border-color: #b5bcc9; }
QPushButton:pressed { background: #c5cad8; }
QPushButton:disabled { color: #9ca0b0; }

/* LineEdit / TextEdit */
QLineEdit, QTextEdit {
    background: #ffffff;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 5px;
    padding: 4px 8px;
    selection-background-color: rgba(30,102,245,0.25);
}
QLineEdit:focus, QTextEdit:focus { border-color: #1e66f5; }

/* ComboBox */
QComboBox {
    background: #ffffff;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 5px;
    padding: 3px 8px;
}
QComboBox:hover { border-color: #b5bcc9; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: #eff1f5;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    selection-background-color: rgba(30,102,245,0.15);
    color: #4c4f69;
}

/* ScrollBar */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #ccd0da;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #b5bcc9; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #ccd0da;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #b5bcc9; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* StatusBar */
QStatusBar {
    background: #e6e9ef;
    border-top: 1px solid #ccd0da;
    color: #6c6f85;
    font-size: 12px;
}

/* Slider */
QSlider::groove:horizontal {
    height: 4px;
    background: #ccd0da;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #1e66f5;
    width: 14px; height: 14px;
    border-radius: 7px;
    margin: -5px 0;
}
QSlider::sub-page:horizontal { background: #1e66f5; border-radius: 2px; }

/* SpinBox */
QSpinBox {
    background: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 5px;
    padding: 3px 6px;
    color: #4c4f69;
}

/* Tooltip */
QToolTip {
    background: #eff1f5;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 5px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ── Sohbet Paneli ────────────────────────────────────────────────────────── */
QListWidget#roomList,
QListWidget#memberList {
    background: #e6e9ef;
    color: #4c4f69;
    font-size: 12px;
    border: none;
    outline: none;
}
QListWidget#roomList::item {
    padding: 7px 10px;
    border-radius: 5px;
    margin: 1px 4px;
}
QListWidget#roomList::item:selected {
    background: #ccd0da;
    color: #4c4f69;
}
QListWidget#roomList::item:hover:!selected {
    background: rgba(204,208,218,0.5);
}
QListWidget#memberList::item {
    padding: 4px 10px;
    font-size: 12px;
}
QTextBrowser#messageArea {
    background: #eff1f5;
    border: none;
    font-size: 13px;
}
QLineEdit#inputLine {
    background: #e6e9ef;
    border: 1px solid #bcc0cc;
    border-radius: 8px;
    color: #4c4f69;
    padding: 6px 10px;
    font-size: 13px;
}
QLineEdit#inputLine:focus {
    border-color: #1e66f5;
}
QSplitter#mainSplitter::handle {
    background: #ccd0da;
    width: 1px;
}
QLabel#lblRooms, QLabel#lblMembers, QLabel#lblRoomTitle {
    background: #e6e9ef;
    color: #7c7f93;
}
QWidget#leftPane  { background: #e6e9ef; }
QWidget#rightPane { background: #eff1f5; }
