#!/bin/bash
# postrm — OKIDIA tam kaldırma sonrası / Post-removal cleanup

set -e

LANG_ENV="${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}"
IS_TR=0
if [[ "$LANG_ENV" =~ ^tr || "$LANG_ENV" =~ ^TR ]]; then
    IS_TR=1
fi

log() {
    local tr_text="$1"
    local en_text="$2"
    if [ "$IS_TR" -eq 1 ]; then
        echo "[OKIDIA] $tr_text"
    else
        echo "[OKIDIA] $en_text"
    fi
}

restore_okidia_dconf_profiles() {
    rm -f /etc/dconf/db/local.d/00-okidia-kiosk /etc/dconf/db/local.d/locks/okidia-kiosk \
          /etc/dconf/db/gdm.d/00-okidia-kiosk /etc/dconf/db/gdm.d/locks/okidia-kiosk

    # /etc/dconf/profile/user yedeğini geri yükle veya Okidia oluşturduysa sil
    if [ -f /etc/dconf/profile/user.okidia-bak ]; then
        mv -f /etc/dconf/profile/user.okidia-bak /etc/dconf/profile/user 2>/dev/null || true
    elif [ -f /etc/dconf/profile/.okidia-created-user ]; then
        rm -f /etc/dconf/profile/user /etc/dconf/profile/.okidia-created-user 2>/dev/null || true
    fi
    rm -f /etc/dconf/profile/.okidia-created-user 2>/dev/null || true

    # /etc/dconf/profile/gdm yedeğini geri yükle veya Okidia oluşturduysa sil
    if [ -f /etc/dconf/profile/gdm.okidia-bak ]; then
        mv -f /etc/dconf/profile/gdm.okidia-bak /etc/dconf/profile/gdm 2>/dev/null || true
    elif [ -f /etc/dconf/profile/.okidia-created-gdm ]; then
        rm -f /etc/dconf/profile/gdm /etc/dconf/profile/.okidia-created-gdm 2>/dev/null || true
    fi
    rm -f /etc/dconf/profile/.okidia-created-gdm 2>/dev/null || true

    if command -v dconf &>/dev/null; then
        dconf update 2>/dev/null || true
    fi
}

case "$1" in
  purge)
    # purge: yapılandırma ve logları sil
    rm -rf /etc/okidia /var/log/okidia /var/lib/okidia /etc/okidia/certs
    
    # postinst içinde dinamik olarak oluşturulan dosyaları ve dconf profillerini geri al
    rm -rf /usr/share/okidia
    restore_okidia_dconf_profiles
    sed -i '/okidia-broker/d' /etc/hosts 2>/dev/null || true
    rm -f /tmp/okidia-tray-*.log /tmp/okidia_cap_*.png 2>/dev/null || true
    rm -rf /etc/systemd/system/okidia-broker.service.d
    rm -f /etc/systemd/system/okidia-agent.service
    rm -f /etc/systemd/system/okidia-agent-recover.service
    rm -f /usr/bin/okidia-agent-recover.sh
    rm -f /var/run/okidia_rollback_in_progress
    if command -v systemctl &>/dev/null; then
        systemctl daemon-reload || true
        systemctl reset-failed okidia-agent.service 2>/dev/null || true
        systemctl reset-failed okidia-agent-recover.service 2>/dev/null || true
    fi

    # Kullanıcı ev dizinlerindeki (ve /root) .config ve .local/share kalıntılarını temizle
    for user_home in /home/* /root /var/lib/gdm3 /var/lib/gdm; do
        if [ -d "$user_home" ]; then
            rm -rf "$user_home/.local/share/gnome-shell/extensions/okidia-kiosk@okidia.net" \
                   "$user_home/.config/okidia" \
                   "$user_home/.config/Okidia" \
                   "$user_home/.config/Unknown Organization" \
                   "$user_home/.config/okidia.conf" \
                   "$user_home/.config/okidia-master" \
                   "$user_home/.config/okidia-agent" \
                   "$user_home/.config/okidia-broker" \
                   "$user_home/.config/okidia-tray" \
                   "$user_home/.config/okidia-broker-tray" \
                   "$user_home/.local/share/okidia" \
                   "$user_home/.local/share/Okidia" \
                   "$user_home/.local/share/okidia-master" \
                   "$user_home/.local/share/okidia-agent" \
                   "$user_home/.local/share/okidia-broker" \
                   "$user_home/.local/share/okidia-tray" \
                   "$user_home/.local/share/okidia-broker-tray"
        fi
    done
    # Kullanıcıyı kaldır
    if id okidia &>/dev/null; then
        userdel okidia || true
    fi
    log "Tüm veriler ve yapılandırma temizlendi." \
        "All configuration files and data have been purged."
    ;;
  remove)
    restore_okidia_dconf_profiles
    for user_home in /home/* /root /var/lib/gdm3 /var/lib/gdm; do
        [ -d "$user_home" ] && rm -rf "$user_home/.local/share/gnome-shell/extensions/okidia-kiosk@okidia.net" 2>/dev/null || true
    done
    log "Paket dosyaları başarıyla kaldırıldı." \
        "Package files have been successfully removed."
    log "Tüm yapılandırmayı ve sertifikaları silmek için: sudo apt purge okidia-*" \
        "To remove all configuration and certificates: sudo apt purge okidia-*"
    ;;
esac

# ── Masaüstü cache temizle ───────────────────────────────────────
if command -v gtk-update-icon-cache &>/dev/null; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor/ 2>/dev/null || true
fi
if command -v update-desktop-database &>/dev/null; then
    update-desktop-database /usr/share/applications/ 2>/dev/null || true
fi

exit 0
